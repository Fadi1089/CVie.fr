{
  "name": "@cvie/server",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "bun --env-file=../.env --watch run src/index.ts",
    "type-check": "tsc --noEmit",
    "test": "bun test --isolate --preload ./test-setup.ts src/services/__tests__ && bun test --isolate --preload ./test-setup.ts src/middleware && bun test --isolate --preload ./test-setup.ts src/routes/__tests__"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/google": "^3.0.71",
    "@ai-sdk/openai": "^3.0.53",
    "@cvie/shared": "workspace:*",
    "ai": "^6.0.168",
    "hono": "^4.10.8",
    "jsonresume-theme-stackoverflow": "^3.3.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.59.1",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pdf-parse": "^1.1.5",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "jose": "^6.2.3",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0"
  }
}
