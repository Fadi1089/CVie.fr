{
	"name": "cvie-fr",
	"version": "0.1.0",
	"description": "CVie.fr — Free ATS-compatible CV platform with portfolio links",
	"author": "Fadi",
	"license": "MIT",
	"private": true,
	"packageManager": "bun@1.2.4",
	"workspaces": [
		"./server",
		"./client",
		"./shared"
	],
	"scripts": {
		"dev": "turbo dev",
		"dev:client": "turbo dev --filter=@cvie/client",
		"dev:server": "turbo dev --filter=@cvie/server",
		"build": "turbo build",
		"build:client": "turbo build --filter=@cvie/client",
		"build:server": "turbo build --filter=@cvie/server",
		"lint": "turbo lint",
		"type-check": "turbo type-check",
		"test": "turbo test",
		"sync:figma-templates": "bun run scripts/sync-figma-templates.ts",
		"generate:template-css": "bun run scripts/generate-template-css.ts",
		"check:template-css": "bun run scripts/generate-template-css.ts --check",
		"smoke:template-previews": "bun run scripts/smoke-template-previews.ts",
		"test:themes": "bun run scripts/test-themes-ats.ts && bun run scripts/test-themes-pdf.ts",
		"postinstall": "turbo build --filter=@cvie/shared && bunx playwright install chromium"
	},
	"devDependencies": {
		"bun-types": "latest",
		"dotenv": "^17.4.2",
		"jose": "^6.2.3",
		"prisma": "^7.7.0",
		"turbo": "^2.6.3"
	},
	"peerDependencies": {
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"@auth0/auth0-react": "^2.16.2",
		"@prisma/adapter-neon": "^7.7.0",
		"@prisma/client": "^7.8.0"
	}
}
