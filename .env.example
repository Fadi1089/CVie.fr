# Database — PostgreSQL (Supabase / Neon)
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# Auth0 — server (validate JWTs)
AUTH0_DOMAIN=cvie-fr.eu.auth0.com
AUTH0_AUDIENCE=https://api.cvie.fr
AUTH0_ISSUER=https://cvie-fr.eu.auth0.com/

# Error Tracking — Sentry
SENTRY_DSN=""

# Server
PORT=3001
NODE_ENV=development

# PDF export — max requests per IP per minute (default 10)
PDF_RATE_LIMIT_PER_MIN=10

# Client (prefix with VITE_ for frontend access)
VITE_SERVER_URL=http://localhost:3001
VITE_AUTH0_DOMAIN=cvie-fr.eu.auth0.com
VITE_AUTH0_CLIENT_ID=replace-with-spa-client-id
VITE_AUTH0_AUDIENCE=https://api.cvie.fr

# AI provider for CV PDF import. Supported: "anthropic" (default) or "openai"
AI_PROVIDER=anthropic

# Required when AI_PROVIDER=anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Required when AI_PROVIDER=openai — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Rate limit for the CV import endpoint (requests per minute, default: 5)
CV_IMPORT_RATE_LIMIT_PER_MIN=5

# Figma template sync — personal access token with file_content:read scope
FIGMA_ACCESS_TOKEN=figd_...
# Optional; defaults to the CV templates file
FIGMA_FILE_KEY=25iovEf8CZdNuAlo8n9P1h
